---
import Layout from '../layouts/Layout.astro';

const jokeModes = [
	'Pirate Build',
	'Robot Debug',
	'Corporate Buzz',
	'Shakespeare Runtime',
	'Cat Compiler',
];

const lines = [
	'Hello, World. I wrote this before coffee. Bold choice.',
	'Hello, World. 0 bugs reported. 37 bugs emotionally implied.',
	'Hello, World. Shipping to prod in 3... 2... 404.',
	'Hello, World. My rubber duck approved this commit.',
	'Hello, World. Works on my machine, your honor.',
	'Hello, World. Deployed with vibes and one suspicious semicolon.',
	'Hello, World. The code is clean. The git history is not.',
];

const statusMessages = [
	'Compiling stand-up routine...',
	'Training AI to laugh at your puns...',
	'Rendering sarcasm at 60fps...',
	'Checking if this joke passed unit tests...',
	'Optimizing punchline delivery...',
];
---

<Layout
	title="Funny Hello World | Astro"
	description="A chaotic and funny Hello World site, ready for GitHub Pages."
>
	<main class="scene">
		<section class="card">
			<p class="tag">Live from the Internet</p>
			<h1>hello world, but make it comedy</h1>
			<p id="status" class="status">{statusMessages[0]}</p>

			<div class="bubble-wrap" aria-live="polite">
				<p id="line" class="line">{lines[0]}</p>
			</div>

			<div class="controls">
				<button id="punch" type="button">Generate another punchline</button>
				<button id="mode" type="button" class="ghost">Switch universe</button>
			</div>

			<p id="modeLabel" class="mode">Current mode: {jokeModes[0]}</p>

			<section class="game-panel" aria-label="Bug Bash mini game">
				<div class="game-head">
					<h2>Bug Bash: 20s Challenge</h2>
					<p>Click the moving BUG as many times as you can before time runs out.</p>
				</div>

				<div class="game-stats">
					<p>Time: <span id="gameTime">20</span>s</p>
					<p>Score: <span id="gameScore">0</span></p>
					<p>Best: <span id="gameBest">0</span></p>
				</div>

				<div id="gameGrid" class="game-grid" role="group" aria-label="Game board">
					<button type="button" class="cell" data-cell="0">...</button>
					<button type="button" class="cell" data-cell="1">...</button>
					<button type="button" class="cell" data-cell="2">...</button>
					<button type="button" class="cell" data-cell="3">...</button>
					<button type="button" class="cell" data-cell="4">...</button>
					<button type="button" class="cell" data-cell="5">...</button>
					<button type="button" class="cell" data-cell="6">...</button>
					<button type="button" class="cell" data-cell="7">...</button>
					<button type="button" class="cell" data-cell="8">...</button>
				</div>

				<p id="gameMessage" class="game-message">Press Start to play.</p>
				<button id="gameStart" type="button" class="game-start">Start game</button>
			</section>

		<section class="game-panel-2" aria-label="Reflex Rally mini game">
			<div class="game-head">
				<h2>Reflex Rally: 30s Sprint</h2>
				<p>Click targets before they vanish! Each lasts ~1 second.</p>
			</div>

			<div class="game-stats">
				<p>Time: <span id="reflexTime">30</span>s</p>
				<p>Score: <span id="reflexScore">0</span></p>
				<p>Best: <span id="reflexBest">0</span></p>
			</div>

			<div id="reflexGrid" class="game-grid" role="group" aria-label="Reflex game board">
				<button type="button" class="target" data-target="0"></button>
				<button type="button" class="target" data-target="1"></button>
				<button type="button" class="target" data-target="2"></button>
				<button type="button" class="target" data-target="3"></button>
				<button type="button" class="target" data-target="4"></button>
				<button type="button" class="target" data-target="5"></button>
				<button type="button" class="target" data-target="6"></button>
				<button type="button" class="target" data-target="7"></button>
				<button type="button" class="target" data-target="8"></button>
			</div>

			<p id="reflexMessage" class="game-message">Ready? Click Start.</p>
			<button id="reflexStart" type="button" class="game-start">Start game</button>
		</section>
	<script type="module" define:vars={{ lines, jokeModes, statusMessages }}>
		const lineEl = document.querySelector('#line');
		const modeLabelEl = document.querySelector('#modeLabel');
		const statusEl = document.querySelector('#status');
		const punchBtn = document.querySelector('#punch');
		const modeBtn = document.querySelector('#mode');
		const gameTimeEl = document.querySelector('#gameTime');
		const gameScoreEl = document.querySelector('#gameScore');
		const gameBestEl = document.querySelector('#gameBest');
		const gameMessageEl = document.querySelector('#gameMessage');
		const gameStartBtn = document.querySelector('#gameStart');
		const gameCells = Array.from(document.querySelectorAll('.cell'));
		const reflexTimeEl = document.querySelector('#reflexTime');
		const reflexScoreEl = document.querySelector('#reflexScore');
		const reflexBestEl = document.querySelector('#reflexBest');
		const reflexMessageEl = document.querySelector('#reflexMessage');
		const reflexStartBtn = document.querySelector('#reflexStart');
		const reflexTargets = Array.from(document.querySelectorAll('.target'));

		let lineIndex = 0;
		let modeIndex = 0;
		let statusIndex = 0;
		let gameScore = 0;
		let gameBest = 0;
		let gameTime = 20;
		let bugCell = -1;
		let gameRunning = false;
		let countdownId;
		let bugMoveId;

		let reflexScore = 0;
		let reflexBest = 0;
		let reflexTime = 30;
		let reflexRunning = false;
		let reflexCountdownId;
		let reflexTargetId;
		let reflexHideId;

		const nextIndex = (current, length) => (current + 1) % length;

		const animatePop = (el) => {
			if (!el) return;
			el.classList.remove('pop');
			void el.offsetWidth;
			el.classList.add('pop');
		};

		const rotateStatus = () => {
			statusIndex = nextIndex(statusIndex, statusMessages.length);
			if (statusEl) {
				statusEl.textContent = statusMessages[statusIndex];
				animatePop(statusEl);
			}
		};

		punchBtn?.addEventListener('click', () => {
			lineIndex = nextIndex(lineIndex, lines.length);
			if (lineEl) {
				lineEl.textContent = lines[lineIndex];
				animatePop(lineEl);
			}
			rotateStatus();
		});

		modeBtn?.addEventListener('click', () => {
			modeIndex = nextIndex(modeIndex, jokeModes.length);
			if (modeLabelEl) {
				modeLabelEl.textContent = `Current mode: ${jokeModes[modeIndex]}`;
				animatePop(modeLabelEl);
			}
			rotateStatus();
		});

		const renderBug = () => {
			gameCells.forEach((cell, index) => {
				const isBug = index === bugCell;
				cell.textContent = isBug ? 'BUG' : '...';
				cell.classList.toggle('is-bug', isBug);
			});
		};

		const moveBug = () => {
			let nextBug = Math.floor(Math.random() * gameCells.length);
			if (gameCells.length > 1 && nextBug === bugCell) {
				nextBug = (nextBug + 1) % gameCells.length;
			}
			bugCell = nextBug;
			renderBug();
		};

		const stopGame = () => {
			gameRunning = false;
			clearInterval(countdownId);
			clearInterval(bugMoveId);
			bugCell = -1;
			renderBug();
			if (gameStartBtn) gameStartBtn.textContent = 'Play again';
			if (gameMessageEl) {
				gameMessageEl.textContent = `Time! Final score: ${gameScore}.`;
			}
		};

		const startGame = () => {
			gameRunning = true;
			gameScore = 0;
			gameTime = 20;
			if (gameScoreEl) gameScoreEl.textContent = String(gameScore);
			if (gameTimeEl) gameTimeEl.textContent = String(gameTime);
			if (gameMessageEl) gameMessageEl.textContent = 'Go! Smash that bug.';
			if (gameStartBtn) gameStartBtn.textContent = 'Running...';

			moveBug();

			clearInterval(countdownId);
			clearInterval(bugMoveId);

			countdownId = setInterval(() => {
				gameTime -= 1;
				if (gameTimeEl) gameTimeEl.textContent = String(gameTime);
				if (gameTime <= 0) {
					stopGame();
				}
			}, 1000);

			bugMoveId = setInterval(() => {
				if (gameRunning) moveBug();
			}, 700);
		};

		gameCells.forEach((cell, index) => {
			cell.addEventListener('click', () => {
				if (!gameRunning) return;
				if (index === bugCell) {
					gameScore += 1;
					if (gameScore > gameBest) {
						gameBest = gameScore;
						if (gameBestEl) gameBestEl.textContent = String(gameBest);
					}
					if (gameScoreEl) gameScoreEl.textContent = String(gameScore);
					moveBug();
				}
			});
		});

		gameStartBtn?.addEventListener('click', () => {
			if (gameRunning) return;
			startGame();
		});

		const showTarget = () => {
			reflexTargets.forEach(t => t.classList.remove('active'));
			const nextTarget = Math.floor(Math.random() * reflexTargets.length);
			reflexTargets[nextTarget].classList.add('active');

			clearTimeout(reflexHideId);
			reflexHideId = setTimeout(() => {
				reflexTargets[nextTarget].classList.remove('active');
				if (reflexRunning) {
					reflexTargetId = setTimeout(showTarget, 400);
				}
			}, 900);
		};

		const stopReflexGame = () => {
			reflexRunning = false;
			clearInterval(reflexCountdownId);
			clearTimeout(reflexTargetId);
			clearTimeout(reflexHideId);
			reflexTargets.forEach(t => t.classList.remove('active'));
			if (reflexStartBtn) reflexStartBtn.textContent = 'Play again';
			if (reflexMessageEl) {
				reflexMessageEl.textContent = `Time! Final score: ${reflexScore}.`;
			}
		};

		const startReflexGame = () => {
			reflexRunning = true;
			reflexScore = 0;
			reflexTime = 30;
			if (reflexScoreEl) reflexScoreEl.textContent = String(reflexScore);
			if (reflexTimeEl) reflexTimeEl.textContent = String(reflexTime);
			if (reflexMessageEl) reflexMessageEl.textContent = 'Targets appear! Click fast!';
			if (reflexStartBtn) reflexStartBtn.textContent = 'Running...';

			reflexTargets.forEach(t => t.classList.remove('active'));
			showTarget();

			clearInterval(reflexCountdownId);
			reflexCountdownId = setInterval(() => {
				reflexTime -= 1;
				if (reflexTimeEl) reflexTimeEl.textContent = String(reflexTime);
				if (reflexTime <= 0) {
					stopReflexGame();
				}
			}, 1000);
		};

		reflexTargets.forEach((target, index) => {
			target.addEventListener('click', () => {
				if (!reflexRunning) return;
				if (target.classList.contains('active')) {
					reflexScore += 1;
					if (reflexScore > reflexBest) {
						reflexBest = reflexScore;
						if (reflexBestEl) reflexBestEl.textContent = String(reflexBest);
					}
					if (reflexScoreEl) reflexScoreEl.textContent = String(reflexScore);
					target.classList.remove('active');
					clearTimeout(reflexHideId);
					if (reflexRunning) {
						reflexTargetId = setTimeout(showTarget, 200);
					}
				}
			});
		});

		reflexStartBtn?.addEventListener('click', () => {
			if (reflexRunning) return;
			startReflexGame();
		});
	</script>
</Layout>

<style>
	:root {
		--paper: #f6f1e8;
		--ink: #1b1f23;
		--sun: #ffb646;
		--tomato: #f85a3e;
		--mint: #6bc8a8;
		--card: #fffdf8;
		--shadow: rgba(27, 31, 35, 0.17);
	}

	* {
		box-sizing: border-box;
	}

	main.scene {
		min-height: 100dvh;
		display: grid;
		place-items: center;
		padding: 2rem 1rem;
		font-family: 'Trebuchet MS', 'Gill Sans', 'Gill Sans MT', Calibri, sans-serif;
		color: var(--ink);
		background:
			radial-gradient(circle at 15% 15%, rgba(255, 182, 70, 0.55), transparent 45%),
			radial-gradient(circle at 85% 15%, rgba(107, 200, 168, 0.45), transparent 38%),
			radial-gradient(circle at 20% 85%, rgba(248, 90, 62, 0.4), transparent 42%),
			linear-gradient(165deg, #fdf7ec 0%, #f6f1e8 100%);
	}

	.card {
		width: min(760px, 100%);
		padding: clamp(1.2rem, 4vw, 2.2rem);
		border-radius: 1.2rem;
		background: var(--card);
		border: 3px solid #222;
		box-shadow: 8px 8px 0 var(--shadow);
	}

	.tag {
		display: inline-block;
		font-weight: 700;
		background: var(--sun);
		padding: 0.3rem 0.65rem;
		border: 2px solid #222;
		border-radius: 999px;
		margin: 0;
	}

	h1 {
		font-size: clamp(1.9rem, 5.2vw, 3rem);
		line-height: 1.05;
		letter-spacing: 0.01em;
		margin: 0.9rem 0;
		text-wrap: balance;
	}

	.status {
		margin: 0;
		font-weight: 700;
		color: #5f4a2f;
	}

	.bubble-wrap {
		margin-top: 1rem;
		padding: 1rem;
		border: 2px dashed #222;
		border-radius: 0.8rem;
		background: #fff;
	}

	.line {
		margin: 0;
		font-size: clamp(1.15rem, 2.7vw, 1.55rem);
		font-weight: 700;
	}

	.controls {
		display: flex;
		gap: 0.75rem;
		margin-top: 1rem;
		flex-wrap: wrap;
	}

	button {
		border: 2px solid #222;
		background: var(--tomato);
		color: #fff;
		font-size: 0.97rem;
		font-weight: 700;
		padding: 0.7rem 1rem;
		border-radius: 0.65rem;
		cursor: pointer;
		transition: transform 120ms ease;
	}

	button:hover {
		transform: translateY(-2px);
	}

	button.ghost {
		background: var(--mint);
		color: #1f2427;
	}

	.mode {
		margin: 1rem 0 0;
		font-weight: 700;
		color: #21353a;
	}

	.game-panel {
		margin-top: 1.25rem;
		padding-top: 1.2rem;
		border-top: 2px solid #222;
	}

	.game-head h2 {
		font-size: clamp(1.1rem, 2.8vw, 1.5rem);
		margin: 0;
	}

	.game-head p {
		margin: 0.35rem 0 0;
		color: #4f4740;
		font-weight: 600;
	}

	.game-stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		margin: 0.9rem 0;
	}

	.game-stats p {
		margin: 0;
		padding: 0.35rem 0.6rem;
		border: 2px solid #222;
		border-radius: 0.6rem;
		background: #fff;
		font-weight: 700;
	}

	.game-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(62px, 1fr));
		gap: 0.55rem;
		max-width: 360px;
	}

	.game-grid .cell {
		aspect-ratio: 1;
		padding: 0;
		margin: 0;
		font-size: 1rem;
		font-weight: 800;
		background: #fff;
		color: #1b1f23;
	}

	.game-grid .cell.is-bug {
		background: #f85a3e;
		color: #fff;
		transform: scale(1.04);
	}

	.game-message {
		margin: 0.85rem 0 0;
		font-weight: 700;
		color: #4a3f34;
	}

	.game-start {
		margin-top: 0.65rem;
	}

	.game-panel-2 {
		margin-top: 1.25rem;
		padding-top: 1.2rem;
		border-top: 2px solid #222;
	}

	.game-panel-2 .game-head h2 {
		font-size: clamp(1.1rem, 2.8vw, 1.5rem);
		margin: 0;
	}

	.game-panel-2 .game-head p {
		margin: 0.35rem 0 0;
		color: #4f4740;
		font-weight: 600;
	}

	.target {
		aspect-ratio: 1;
		padding: 0;
		margin: 0;
		font-size: 1rem;
		font-weight: 800;
		background: #f0f0f0;
		color: #999;
		transition: background 60ms ease, color 60ms ease, transform 60ms ease;
	}

	.target.active {
		background: #6bc8a8;
		color: #fff;
		transform: scale(1.06);
		box-shadow: 0 0 0 3px rgba(107, 200, 168, 0.3);
	}

	.pop {
		animation: pop 320ms ease;
	}

	@keyframes pop {
		0% {
			transform: scale(0.97);
			opacity: 0.5;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}

	@media (max-width: 560px) {
		.card {
			padding: 1rem;
			border-radius: 1rem;
		}

		button {
			width: 100%;
		}

		.game-grid {
			max-width: 100%;
		}

		.game-grid .cell {
			width: 100%;
		}
	}
</style>
